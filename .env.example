SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

POSTGRES_DB=finance
DB_URL=jdbc:postgresql://localhost:5432/finance
DB_USERNAME=finance
DB_PASSWORD=replace-with-a-local-password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_RATE_LIMIT_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_SESSION_DURATION=PT30M
AUTH_SESSION_IDLE_TIMEOUT=PT15M
AUTH_SESSION_ACTIVITY_UPDATE_INTERVAL=PT5M
AUTH_REGISTRATION_RATE_MAX_ATTEMPTS=5
AUTH_REGISTRATION_RATE_WINDOW=PT1H
AUTH_REGISTRATION_RATE_BLOCK_DURATION=PT1H

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC
